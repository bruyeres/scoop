    "post_install": [
        "New-Item \"$dir\\portable_mode_enabled\" -ItemType File -Force | Out-Null",
        "if (!(Test-Path \"$persist_dir\\profile\\*\") -and (Test-Path \"$env:AppData\\foobar2000-v2\")) {",
        "    info '[Portable Mode]: Copying user data...'",
        "    Copy-Item \"$env:AppData\\foobar2000-v2\\*\" -Destination \"$persist_dir\\profile\" -Force -Recurse",
        "}",
        "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\`$R0\", \"$dir\\uninstall.exe\" -Recurse -Force -ErrorAction SilentlyContinue"
    ],
    "shortcuts": [
        [
            "foobar2000.exe",
            "foobar2000"
        ]
    ],
    "persist": "profile",
    "checkver": {
        "url": "https://www.foobar2000.org/windows",
        "regex": "foobar2000-x64_v([\\d.]+)\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://www.foobar2000.org/downloads/foobar2000-x64_v$version.exe#/dl.7z"
            },
            "32bit": {
                "url": "https://www.foobar2000.org/downloads/foobar2000_v$version.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://www.foobar2000.org/downloads/foobar2000-arm64ec_v$version.exe#/dl.7z"
            }
        }
    }
}
